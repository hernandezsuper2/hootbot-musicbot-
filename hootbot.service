# HootBot - systemd service unit
#   sudo cp ~/HootBot/hootbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hootbot
# Logs: journalctl -u hootbot -f   (also ~/HootBot/hootsbot.log)
[Unit]
Description=HootBot Discord Music Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roy-hernandez
WorkingDirectory=/home/roy-hernandez/HootBot
ExecStart=/home/roy-hernandez/HootBot/.venv/bin/python /home/roy-hernandez/HootBot/main.py
Restart=always
RestartSec=10
EnvironmentFile=/home/roy-hernandez/HootBot/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
