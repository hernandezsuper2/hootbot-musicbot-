# Copy this file to .env and fill in your real values. Do NOT commit .env to git.

# Required: your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=YOUR_TOKEN_HERE

# Optional (Windows only): path to Node.js install if not in the default location.
# Default is C:\Program Files\nodejs — only set this if Node is installed elsewhere.
# NODEJS_PATH=C:\Program Files\nodejs
