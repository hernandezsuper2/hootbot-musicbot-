# Copy this file to .env and fill in your real values. Do NOT commit .env to git.

# Required: your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=YOUR_TOKEN_HERE

# Optional (Windows only): path to Node.js install if not in the default location.
# Default is C:\Program Files\nodejs — only set this if Node is installed elsewhere.
# NODEJS_PATH=C:\Program Files\nodejs

# ---- Server-specific settings (optional; leave a value empty to disable that feature) ----
# Discord IDs: enable Developer Mode in Discord, then right-click a user/channel -> Copy ID.

# Bots allowed to send HootBot commands, comma-separated (e.g. OpenClaw, which uses .playfor)
TRUSTED_BOT_IDS=
# If set, all bot responses go to this text channel
BOT_OUTPUT_CHANNEL_ID=
# User the .skeet command is aimed at
SKEET_USER_ID=

# Welcome sound: plays WELCOME_SOUND (a file in intros/) when WELCOME_USER_ID joins the
# voice channel named WELCOME_CHANNEL_NAME. Off after every restart until an admin runs .welcomeon
WELCOME_USER_ID=
WELCOME_CHANNEL_NAME=
WELCOME_SOUND=
